# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://terrasentry:terrasentry@localhost:5432/terrasentry?sslmode=disable

# Risk scoring service
RISK_SCORING_URL=http://localhost:8000

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Push notifications (used in Phase 4 for mobile approvals)
FCM_SERVER_KEY=your-firebase-cloud-messaging-server-key

# Kubernetes (used in Phase 3 by the operator)
KUBECONFIG_PATH=~/.kube/config