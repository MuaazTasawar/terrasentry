# # Server
# PORT=8000
# ENV=development

# # LLM provider (Anthropic used by default; swap client in llm_client.py if needed)
# LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL=claude-sonnet-4-6

# # Risk thresholds
# RISK_SCORE_HIGH_THRESHOLD=75
# RISK_SCORE_MEDIUM_THRESHOLD=40
PORT=8000
ENV=development
LLM_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
RISK_SCORE_HIGH_THRESHOLD=75
RISK_SCORE_MEDIUM_THRESHOLD=40
POLICY_FILE_PATH=app/policy.yaml